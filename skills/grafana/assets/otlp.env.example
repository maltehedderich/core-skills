# Trusted server only. Supply real values through the existing secret manager.
# Check the chosen SDK: these settings need an initialized metric provider/reader.
OTEL_SERVICE_NAME=example-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
# Set service.instance.id per process at startup unless the SDK already does: a random UUID,
# or the platform's instance, task, or pod ID. A fixed value here is shared by every replica,
# and their cumulative counters then collide in one series.
# Copy the complete base URL from the stack's OpenTelemetry connection page.
OTEL_EXPORTER_OTLP_ENDPOINT=https://STACK_OTLP_GATEWAY/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Runtime secret: Basic authentication uses base64(OTLP_INSTANCE_ID:METRICS_WRITE_TOKEN).
# The OTel spec percent-encodes header values, so the space is %20. Check the SDK's
# parsing; do not commit the resolved value.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20REPLACE_WITH_RUNTIME_SECRET
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=5000
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Add app/environment/operation as bounded metric attributes in instrumentation.
# This example is an env-file checklist, not a shell script to source.
